{
    "characters": [
        {
            "id": "C1",
            "name": "Hercule Poirot",
            "role": "character1",
            "startNode": [
                "herculepoirot"
            ],
            "desc": "Brilliant Belgian detective, renowned for his meticulous methods and keen attention to detail in solving crimes."
        },
        {
            "id": "C2",
            "name": "Arthur Hastings",
            "role": "character2",
            "startNode": [
                "arthurhastings"
            ],
            "desc": "Poirot's close friend, serving as the story narrator, characterized by his loyalty, curiosity, and occasional impulsiveness."
        },
        {
            "id": "C3",
            "name": "John Cavendish",
            "role": "character3",
            "startNode": [
                "johncavendish"
            ],
            "desc": "Emily Inglethorp's stepson, practical and reserved, with a strained relationship with his stepmother."
        },
        {
            "id": "C4",
            "name": "Mary Cavendish",
            "role": "character4",
            "startNode": [
                "marycavendish"
            ],
            "desc": "John's wife, dignified and composed, concealing deeper emotions beneath her serene exterior."
        },
        {
            "id": "C5",
            "name": "Evelyn Howard",
            "role": "character5",
            "startNode": [
                "evelynhoward"
            ],
            "desc": "Friend of the family, spirited and outspoken, providing a contrast to the reserved English mannerisms."
        },
        {
            "id": "C6",
            "name": "Cynthia Murdoch",
            "role": "character6",
            "startNode": [
                "cynthiamurdoch"
            ],
            "desc": "Emily Inglethorp's loyal companion, kind-hearted and observant, drawn into the unfolding mystery."
        },
        {
            "id": "C7",
