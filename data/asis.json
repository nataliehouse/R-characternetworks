{
    "characters": [
        {
            "id": "C1",
            "name": "Sherlock Holmes",
            "role": "character1",
            "startNode": [
                "sherlockholmes"
            ],
            "desc": "Brilliant detective, unravels mysteries through keen observation, deduction, and analytical reasoning."
        },
        {
            "id": "C2",
            "name": "John Watson",
            "role": "character2",
            "startNode": [
                "johnwatson"
            ],
            "desc": "Holmes's loyal friend and chronicler, astute observer, provides practical assistance and moral support."
        },
        {
            "id": "C3",
            "name": "Detective Gregson",
            "role": "character3",
            "startNode": [
                "gregson"
            ],
            "desc": "Scotland Yard detective, competent but overshadowed by Holmes's brilliance, diligent in his investigations."
        },
        {
            "id": "C4",
            "name": "John Ferrier",
            "role": "character4",
            "startNode": [
                "johnferrier"
            ],
            "desc": "Kind-hearted and protective towards Lucy, adopts and cares for her, meets a tragic end."
        },
        {
            "id": "C5",
            "name": "Jefferson Hope",
            "role": "character5",
            "startNode": [
                "jeffersonhope"
            ],
            "desc": "Driven by revenge, ultimately meets justice, his actions motivated by love and past grievances."
        },
        {
            "id": "C6",
            "name": "Inspector Lestrade",
            "role": "character6",
            "startNode": [
                "lestrade"
            ],
            "desc": "Scotland Yard inspector, competent but often outshone by Holmes, relies on conventional methods."
        },
        {
            "id": "C7",
            "name": "Lucy Ferrier",
            "role": "character7",
            "startNode": [
                "lucyferrier"
            ],
            "desc": "Orphaned and vulnerable, finds refuge with Ferrier, caught in a web of intrigue and danger."
        },
        {
            "id": "C8",
            "name": "Stamford",
            "role": "character8",
            "startNode": [
                "stamford"
            ],
            "desc": "Watson's acquaintance who introduces him to Holmes, facilitates their friendship and collaboration."
        },
        {
            "id": "C9",
            "name": "John Rance",
